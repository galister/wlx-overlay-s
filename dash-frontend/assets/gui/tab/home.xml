<layout version="2">
  <include src="@/gui/t_menu_button.xml" />

  <template name="MiscButton">
    <Button
      id="${id}" macro="home_button"
      min_width="64" height="36"
      padding_left="8" padding_right="8">
      <div gap="8"
        align_items="center"
        justify_content="center"
        flex_direction="row">
        <sprite src_builtin="${icon}" width="24" height="24" />
        <label weight="bold" size="18" text="${text}" translation="${translation}" />
      </div>
    </Button>
  </template>

  <elements>
    <div
      flex_direction="column"
      justify_content="center"
      align_items="center"
      flex_grow="1"
      gap="8"
      >
      <image src_builtin="@/dashboard/splash.png" width="300" height="89" />

      <!-- supporters -->
      <Button
        id="btn_supporter"
        width="fit_content"
        height="24"
        text=" "
        border_color="tertiary(transparent)"
        hover_border_color="tertiary"
        color="background_variant(transparent)"
        hover_color="tertiary(transparent)"/>

      <label id="label_hello" margin_top="24" size="32" weight="bold" color="on_background" />

      <!-- main button list -->
      <div flex_direction="row" gap="8" margin_top="32">
        <MenuButton id="btn_apps" icon="@/dashboard/apps.svg" translation="APPLICATIONS" />
        <MenuButton id="btn_games" icon="@/dashboard/games.svg" translation="GAMES" />
        <MenuButton id="btn_monado" icon="@/dashboard/monado.svg" text="Monado" />
        <MenuButton id="btn_settings" icon="@/dashboard/settings.svg" translation="SETTINGS" />
      </div>

      <div gap="8">
        <MiscButton id="btn_welcome_screen" icon="@/dashboard/welcome.svg" translation="APP_SETTINGS.TUTORIAL"/>
        <MiscButton id="btn_website" icon="@/dashboard/globe.svg" text="wayvr.org"/>
        <MiscButton id="btn_donate" icon="@/dashboard/opencollective.svg" translation="DONATE.SUPPORT_US"/>
      </div>
    </div>
  </elements>
</layout>
